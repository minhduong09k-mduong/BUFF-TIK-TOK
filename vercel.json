{
  "version": 2,
  "builds": [
    { "src": "api/like.py", "use": "@vercel/python" },
    { "src": "api/view.py", "use": "@vercel/python" },
    { "src": "api/fl.py", "use": "@vercel/python" }
  ],
  "rewrites": [
    { "source": "/api/like", "destination": "/api/like.py" },
    { "source": "/api/view", "destination": "/api/view.py" },
    { "source": "/api/fl", "destination": "/api/fl.py" }
  ]
}
